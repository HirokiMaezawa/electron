{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",          // ★ ここがポイント：exports を出さない
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/renderer.ts"]
}